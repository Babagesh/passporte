{
  "name": "Passporte",
  "packages": {
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios-spm.git",
      "from": "5.39.0"
    }
  },
  "options": {
    "bundleIdPrefix": "app.bitrig.new",
    "deploymentTarget": {
      "iOS": "27.1"
    }
  },
  "targets": {
    "Passporte": {
      "type": "application",
      "platform": "iOS",
      "dependencies": [
        { "package": "RevenueCat", "product": "RevenueCat" },
        { "package": "RevenueCat", "product": "RevenueCatUI" }
      ],
      "sources": [
        "App"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.da817468-f159-4c03-b6e8-58a7a706385f",
          "PRODUCT_NAME": "Passporte",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "GENERATE_INFOPLIST_FILE": "YES",
          "INFOPLIST_KEY_CFBundleDisplayName": "Passporte",
          "INFOPLIST_KEY_NSCameraUsageDescription": "Passporte uses the camera to add travel photos to your visa stamps.",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
          "TARGETED_DEVICE_FAMILY": "1",
          "SWIFT_VERSION": "5.0"
        }
      }
    }
  }
}
